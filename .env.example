# SNInsightTerminal local environment template.
# Copy this file to .env and fill in your own keys.
# Do not commit .env or real API keys.

SN_ALPHA_VANTAGE_KEY=your_alpha_vantage_api_key_here
SN_NEWSAPI_KEY=your_newsapi_key_here
SN_TUSHARE_TOKEN=your_tushare_token_here
SN_LOCAL_API_PROVIDER_ENABLED=false
SN_LOCAL_API_PROVIDER_ID=custom_http_provider
SN_LOCAL_API_PROVIDER_BASE_URL=https://local-provider.example
SN_LOCAL_API_PROVIDER_TOKEN=your_local_api_provider_token_here
SN_DATA_DIR=app_data
SN_LOG_LEVEL=INFO
