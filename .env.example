# SNInsightTerminal local environment template.
# Copy this file to .env and fill in your own keys.
# Do not commit .env or real API keys.

SN_ALPHA_VANTAGE_KEY=your_alpha_vantage_api_key_here
SN_NEWSAPI_KEY=your_newsapi_key_here
SN_MANAGED_PROXY_ENABLED=false
SN_MANAGED_PROXY_BASE_URL=https://managed-proxy.example
SN_MANAGED_PROXY_TOKEN=your_managed_proxy_token_here
SN_MANAGED_PROXY_TIMEOUT_SECONDS=20
SN_DATA_DIR=app_data
SN_LOG_LEVEL=INFO
